# With no credentials, npm run dev starts in local demo mode.
# Set to 0 to require Supabase, including in development.
LOGSTER_DEMO_MODE=0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for the forecast cron, alongside a random cron secret.
SUPABASE_SERVICE_ROLE_KEY=
LOGSTER_CRON_SECRET=
